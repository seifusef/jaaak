# Platform runner folders (web/ index.html is committed; the rest of web/
# plus android/ios/etc. are generated with `flutter create .`).
android/
ios/
linux/
macos/
windows/
web/*
!web/index.html

# QUL data files MAY be committed to assets/indopak/ (simplest path for the
# GitHub Pages workflow) or downloaded by tool/fetch_qul_assets.sh.
# The web JSON asset is always generated at build time — never commit it.
assets/indopak/mushaf_data.json
